# Reference only. instance-new generates the real .env automatically in
# ~/dockers/<instance>/.env from its arguments — you shouldn't normally
# create or edit one of these by hand.

INSTANCE=my-instance
ODOO_VERSION=16.0
POSTGRES_VERSION=13.0

# Only used by the "server" profile:
DOMAIN=
CONTACT=

# One of: local, dev, server
COMPOSE_PROFILE=dev
