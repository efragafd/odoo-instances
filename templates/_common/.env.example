# Reference only. instance-new generates the real .env automatically in
# ~/dockers/<instance>/.env from its arguments — you shouldn't normally
# create or edit one of these by hand.

INSTANCE=my-instance
ODOO_VERSION=16.0
# postgres image tags have no ".0" suffix (13, 13.23, 16, 16.13, ... — not
# "13.0"). instance-new fills this in from templates/<version>/postgres-version.default
# if you don't pass --postgres-version.
POSTGRES_VERSION=13

# Only used by the "server" profile:
DOMAIN=
CONTACT=

# One of: local, dev, server
COMPOSE_PROFILE=dev
