#!/bin/bash
set -e

SCRIPTPATH=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(dirname "$SCRIPTPATH")

random_secret() {
    head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24
}

usage() {
    cat <<USAGE
USAGE: instance-new INSTANCE VERSION [options]

  Create a new Odoo instance under ~/dockers/INSTANCE and bring it up.
  VERSION must have a directory under templates/, e.g. 19.0.

  --profile local|dev|server   default: dev
                                  local   published ports, no debugger
                                  dev     local + debugpy attach on :5678
                                  server  restart=always, named addons
                                          volume, nginx-proxy vhost
  --postgres-version VERSION   default: the version in
                                templates/VERSION/postgres-version.default
                                (falls back to 13 if that file is absent)
  --domain DOMAIN               required for --profile server
  --contact EMAIL                required for --profile server
USAGE
}

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    usage
    exit 0
fi

[ $# -lt 2 ] && { usage >&2; exit 1; }

INSTANCE=$1
VERSION=$2
shift 2

PROFILE=dev
POSTGRES_VERSION=
DOMAIN=
CONTACT=

while [ $# -gt 0 ]; do
    case "$1" in
        --profile) PROFILE=$2; shift 2 ;;
        --postgres-version) POSTGRES_VERSION=$2; shift 2 ;;
        --domain) DOMAIN=$2; shift 2 ;;
        --contact) CONTACT=$2; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
    esac
done

case "$PROFILE" in
    local|dev|server) ;;
    *) echo "Unknown profile '$PROFILE' (expected local, dev, or server)" >&2; exit 1 ;;
esac

if [ "$PROFILE" = "server" ] && { [ -z "$DOMAIN" ] || [ -z "$CONTACT" ]; }; then
    echo "profile 'server' requires --domain and --contact" >&2
    exit 1
fi

if [ ! -d "$REPO_ROOT/templates/$VERSION" ]; then
    echo "No template for Odoo version '$VERSION' (expected templates/$VERSION/)" >&2
    exit 1
fi

if [ "$PROFILE" = "dev" ] && [ ! -f "$REPO_ROOT/templates/$VERSION/odoo_debug/Dockerfile" ]; then
    echo "No debug image available for version '$VERSION' (expected templates/$VERSION/odoo_debug/Dockerfile)" >&2
    exit 1
fi

if [ -z "$POSTGRES_VERSION" ]; then
    if [ -f "$REPO_ROOT/templates/$VERSION/postgres-version.default" ]; then
        POSTGRES_VERSION=$(cat "$REPO_ROOT/templates/$VERSION/postgres-version.default")
    else
        POSTGRES_VERSION=13
    fi
fi

INSTANCE_DIR="$HOME/dockers/$INSTANCE"

if [ -d "$INSTANCE_DIR" ]; then
    echo "Instance '$INSTANCE' already exists at $INSTANCE_DIR" >&2
    exit 2
fi

mkdir -p "$INSTANCE_DIR/addons"
cp -r "$REPO_ROOT/templates/_common/config" "$INSTANCE_DIR/config"

if [ "$PROFILE" != "server" ]; then
    cp -r "$REPO_ROOT/templates/_common/.vscode" "$INSTANCE_DIR/.vscode"
fi

if [ "$PROFILE" = "dev" ]; then
    cp -r "$REPO_ROOT/templates/$VERSION/odoo_debug" "$INSTANCE_DIR/odoo_debug"
fi

DB_PASSWORD=
ADMIN_PASSWD=

if [ "$PROFILE" = "server" ]; then
    DB_PASSWORD=$(random_secret)
    ADMIN_PASSWD=$(random_secret)

    if command -v nproc >/dev/null 2>&1; then
        CPU_COUNT=$(nproc)
    else
        CPU_COUNT=1
    fi
    WORKERS=$((2 * CPU_COUNT + 1))

    # Real (uncommented) settings, appended after the commented reference
    # block that templates/_common/config/odoo.conf ships. Deliberately
    # does NOT set db_host/db_user/db_password here: the odoo image's
    # entrypoint only injects those from the HOST/USER/PASSWORD environment
    # variables (set in compose.server.yml) when the config file doesn't
    # already define them — setting db_password here would take precedence
    # and silently ignore DB_PASSWORD from .env.
    cat >> "$INSTANCE_DIR/config/odoo.conf" <<CONF

; --- generated by instance-new for the server profile ---
proxy_mode = True
list_db = False
admin_passwd = $ADMIN_PASSWD
workers = $WORKERS
max_cron_threads = 2
limit_time_cpu = 60
limit_time_real = 120
CONF
fi

cat > "$INSTANCE_DIR/.env" <<ENV
INSTANCE=$INSTANCE
ODOO_VERSION=$VERSION
POSTGRES_VERSION=$POSTGRES_VERSION
DOMAIN=$DOMAIN
CONTACT=$CONTACT
DB_PASSWORD=$DB_PASSWORD
COMPOSE_PROFILE=$PROFILE
ENV

echo "Instance directory created at $INSTANCE_DIR (profile: $PROFILE)"

if [ "$PROFILE" = "server" ]; then
    echo
    echo "Generated database manager password (needed at /web/database/manager):"
    echo "  $ADMIN_PASSWD"
    echo "It is saved in $INSTANCE_DIR/config/odoo.conf — this is the only time it is printed."
    echo
fi

"$SCRIPTPATH/instance-up" "$INSTANCE"
