#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: instance-up INSTANCE

  Bring up an existing instance (docker compose up -d --build), using the
  profile recorded in its .env. Called automatically by instance-new; use
  this directly after instance-down/instance-stop, or after editing an
  instance's config.
USAGE
    exit 0
fi

INSTANCE=$1
set -e

SCRIPTPATH=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
source "$SCRIPTPATH/_lib.sh"

instance_compose_args "$INSTANCE"

docker compose -p "$INSTANCE" "${COMPOSE_ARGS[@]}" up -d --build

echo "Instance '$INSTANCE' is up (profile: ${COMPOSE_PROFILE:-local})"
