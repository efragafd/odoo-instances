#!/bin/bash
INSTANCE=$1
set -e

SCRIPTPATH=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
source "$SCRIPTPATH/_lib.sh"

INSTANCE_DIR="$HOME/dockers/$INSTANCE"

if [ ! -d "$INSTANCE_DIR" ]; then
    echo "Instance '$INSTANCE' does not exist" >&2
    exit 1
fi

instance_compose_args "$INSTANCE"

# `down -v` removes every volume declared for this project's profile
# (web-data/db-data always, plus extra-addons/backups for server instances),
# instead of a hardcoded two-volume list that silently missed the rest.
docker compose -p "$INSTANCE" "${COMPOSE_ARGS[@]}" down -v

rm -rf "$INSTANCE_DIR"
