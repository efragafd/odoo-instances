#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: mkmod INSTANCE MODULE_NAME

  Scaffold a new Odoo module named MODULE_NAME into INSTANCE's addons/
  (via odoo scaffold), fix its ownership (scaffold runs as root), and
  copy the instance's .vscode/ into the new module directory so a
  per-module VS Code workspace can be opened with instance-code-m.
USAGE
    exit 0
fi

INSTANCE=$1;
MODULE_NAME=$2;

set -e;

docker exec -u root -it $INSTANCE /usr/bin/odoo scaffold $MODULE_NAME /mnt/extra-addons

sudo chown $(whoami):$(whoami) -R $HOME/dockers/$INSTANCE/addons/$MODULE_NAME/

# copy recursively from templates folders the necessary items
sudo cp -r $HOME/dockers/$INSTANCE/.vscode $HOME/dockers/$INSTANCE/addons/$MODULE_NAME/