#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: instance-restart INSTANCE

  instance-stop followed by instance-up.
USAGE
    exit 0
fi

SCRIPT=`realpath $0`;
SCRIPTPATH=`dirname $SCRIPT`;
INSTANCE=$1;
set -e;

$SCRIPTPATH/instance-stop $INSTANCE;
$SCRIPTPATH/instance-up $INSTANCE;
