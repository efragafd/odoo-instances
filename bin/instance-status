#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: instance-status INSTANCE [ANYTHING]

  Print docker ps status for INSTANCE's web container, as one line of
  JSON: {"name": ..., "status": ...}. Pass any second argument (its value
  is ignored — it's a presence check, not a database name) to check the
  db container instead.
USAGE
    exit 0
fi

INSTANCE=$1;
DB=$2;
set -e;

if [ -z $DB ]; then
    NAME=$INSTANCE;
else
    NAME=$INSTANCE"_db";
fi

# MSYS_NO_PATHCONV: see instance-exec-odoo — the ^/NAME$ filter value
# below starts with "/" and gets mangled by Git Bash on Windows otherwise.
MSYS_NO_PATHCONV=1 docker ps -a --filter name=^/$NAME$ --format '{"name": "{{.Names}}", "status": "{{.Status}}"}' | sed '$!s/$/,/';
