#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: instance-exec INSTANCE CMD [ARGS...]

  Run CMD interactively inside INSTANCE's web container (as the odoo user).
USAGE
    exit 0
fi

INSTANCE=$1;
set -e;

# MSYS_NO_PATHCONV: see instance-exec-odoo — a leading-slash CMD (e.g.
# /usr/bin/odoo) would otherwise get mangled by Git Bash on Windows.
MSYS_NO_PATHCONV=1 docker exec -it $INSTANCE ${@:2}
