#!/bin/bash
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat <<USAGE
USAGE: instance-dev-open INSTANCE

  Open http://localhost:8069 (INSTANCE's web UI) in the default browser.
  Assumes the instance's ports are published on localhost — true for the
  "local" and "dev" profiles, not "server".
USAGE
    exit 0
fi

INSTANCE=$1;
set -e;

URL="http://localhost:8069"

if command -v wslview >/dev/null 2>&1; then
    # WSL
    wslview "$URL"
elif command -v xdg-open >/dev/null 2>&1; then
    # Linux
    xdg-open "$URL"
elif command -v open >/dev/null 2>&1; then
    # macOS
    open "$URL"
else
    echo "No known browser-opener found (tried wslview, xdg-open, open)." >&2
    echo "Open manually: $URL" >&2
    exit 1
fi
